# Postgres connection used server-side by api/rooms/*.js (via src/lib/db.js) — the
# app's own draft/sealed room state. Point this at a Supabase project's Postgres
# connection string (Project Settings -> Database), or a local Postgres.
DATABASE_URL=

# Realtime client config — read at runtime by api/realtime-config.js and handed to the
# browser (see src/lib/supabase.js). Only needed if DATABASE_URL points at a Supabase
# project (Supabase's own hosted Realtime); leave unset for a self-hosted Realtime setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Altered Re:Union / Community services (src/lib/endpoints.js). All optional: unset =
# prod. Read server-side; the browser gets the public ones from /api/config. Override
# them to plug in local versions of those services — `make dev` fills KEYCLOAK_ISSUER,
# KEYCLOAK_CLIENT_SECRET and DECKS_API_URL for the ../altered-dev-environment stack and registers the matching Keycloak client
# (scripts/keycloak-dev-client.mjs).
# prod https://auth.altered.re/realms/players · local http://auth.altered.local.gd:18080/realms/players
KEYCLOAK_ISSUER=
# default altered-draft
KEYCLOAK_CLIENT_ID=
# Confidential client secret. Real environments: Vercel env var / secret manager only.
KEYCLOAK_CLIENT_SECRET=
# prod https://decks.alteredcore.org · local http://localhost:8001
DECKS_API_URL=
# prod https://deckbuilder.alteredcore.org (no local version yet)
DECKBUILDER_URL=
# prod https://altered.re · local (altered-website) http://localhost:18181
REUNION_URL=
# prod https://cards.alteredcore.org · local altered-core-cards-api, e.g. http://localhost:8889
CARDS_API_URL=
# prod https://cdn.alteredcore.org (card images + game assets)
CDN_URL=
# prod https://raw.githubusercontent.com/PolluxTroy0/Altered-TCG-Card-Database/main/SETS (community card DB, set files)
CARD_DB_URL=

# LOCAL DEV ONLY — never set in a deployed environment. Extra CA for the API server, to
# trust a local service's self-signed certificate (e.g.
# altered-core-cards-api's Caddy: docker cp <php container>:/data/caddy/pki/authorities/local/root.crt).
# Passed as a real env var by `make dev` / `make api` (Node ignores it in --env-file).
NODE_EXTRA_CA_CERTS=

# User-created tournaments (docs/tournaments/user-tournaments-spec.md §9). Both optional.
# Moderators can edit/cancel/delete any tournament and have no creation limit.
# A Keycloak realm role name, read from the access token's realm_access.roles:
TOURNAMENT_MODERATOR_ROLE=
# ...and/or a comma-separated allowlist of Keycloak subs:
TOURNAMENT_MODERATORS=
